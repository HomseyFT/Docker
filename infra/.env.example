DOMAIN=example.com

# Pi-hole admin password
WEB_PASSWORD=

# Homelab-Helper-Site backend
HOMELAB_DJANGO_SECRET_KEY=
HOMELAB_DB_PASSWORD=

# Marist backend (must match MYSQL_PW in marist/.env)
MARIST_DJANGO_SECRET_KEY=
MARIST_DB_PASSWORD=

# frozen-caboose backend (Postgres)
FROZEN_DJANGO_SECRET_KEY=
FROZEN_DB_PASSWORD=

# Project-Demos backend - optional tunables, all have safe defaults
# DEMOS_PHYSICS_MAX_SESSIONS=20
# DEMOS_PHYSICS_MAX_SESSION_SECONDS=600
# DEMOS_MAX_CONCURRENT_RUNS=4
# DEMOS_QUINLANG_RUN_TIMEOUT_SECONDS=8
# DEMOS_IMGCODEC_RUN_TIMEOUT_SECONDS=12
