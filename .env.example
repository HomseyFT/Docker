# Copy this file to a `.env` in each stack directory that needs it and fill in
# real values. `.env` is gitignored; this template is not. Never commit secrets.
#
#   cp .env.example infra/.env
#   cp .env.example cloudflared/.env
#   cp .env.example marist/.env
#   cp .env.example forgejo/.env
#   cp .env.example socks/.env
#
# Compose only auto-loads the `.env` sitting next to the compose file it runs,
# so each stack directory needs its own copy of the vars it references.

# ---- shared ----------------------------------------------------------------
# Base domain all the *.${DOMAIN} Traefik router rules hang off.
DOMAIN=devazul.com

# ---- cloudflared/ ----------------------------------------------------------
# Tunnel UUID, and the connector token from the Cloudflare Zero Trust dashboard.
CF_TUNNEL_ID=
CF_TUNNEL_TOKEN=

# ---- infra/ ----------------------------------------------------------------
# Pi-hole admin web password.
WEB_PASSWORD=

# ProtonVPN OpenVPN credentials (NOT your Proton account login — these come from
# account.protonvpn.com -> Account -> OpenVPN / IKEv2 username).
VPN_USER=
VPN_PASSWORD=

# Homelab-Helper-Site Django app. Generate the secret key with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
HOMELAB_DJANGO_SECRET_KEY=
HOMELAB_DB_PASSWORD=

# Marist Django app. MARIST_DB_PASSWORD must hold the same value as MYSQL_PW
# in marist/.env — the names differ, the value must not.
MARIST_DJANGO_SECRET_KEY=
MARIST_DB_PASSWORD=

# Finance app. Note there is deliberately no Cloudflare tunnel route for this
# one — it is reachable over LAN/Tailscale only, because it holds bank data.
FINANCE_DJANGO_SECRET_KEY=
FINANCE_DB_PASSWORD=
# Optional. Model used only for suggesting categories on unmatched merchants;
# imports work fine without Ollama running.
FINANCE_OLLAMA_MODEL=llama3.1:8b
# Optional ntfy push for budget and subscription alerts. Leave blank to keep
# alerts in-app only.
FINANCE_NTFY_URL=
FINANCE_NTFY_TOPIC=

# ---- marist/ ---------------------------------------------------------------
# MySQL credentials for the Marist database.
# MYSQL_PW must equal MARIST_DB_PASSWORD in infra/.env.
MYSQL_PW=
MYSQL_ROOT_PW=
