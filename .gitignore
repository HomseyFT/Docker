# Global ignore for container stacks

# Environment / secrets
.env
.env.*
**/.env
**/.env.*
!**/.env.example
**/cert.json
**/cert*.json
**/secrets/

# ...but the template is meant to be committed. This negation MUST stay below
# every .env pattern above — a later match wins, so putting it higher silently
# re-ignores the file.
!.env.example
!**/.env.example

# Application state databases (contain password hashes, session secrets)
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3
infra/kuma/

# Editor / shell backups — these have leaked plaintext secrets before
**/*.bak
**/*.save
**/*.orig
**/*~

# Logs
**/*.log
**/*.log.*

# Runtime/state directories (bind-mounted data, caches, etc.)
**/data/
**/tmp/
**/cache/
infra/pgdata/
